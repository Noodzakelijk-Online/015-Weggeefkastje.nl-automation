# Server defaults to loopback. Do not bind publicly without a trusted HTTPS proxy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_DATA_DIR=data
DATABASE_PATH=data/weggeefkastjes.sqlite
WEB_DIST_PATH=dist-web
SESSION_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=false
ALLOW_NETWORK_BINDING=false
ALLOW_REMOTE_SETUP=false
# Optional public base URL. Used only to make full caretaker links; use HTTPS for a network deployment.
APP_BASE_URL=
# Optional UUID of the workspace visible through the public resident finder. Without it, exactly one workspace is required.
PUBLIC_WORKSPACE_ID=
COOKIE_SECURE=false
ENABLE_DEMO_MODE=false
WORKER_POLL_MS=5000

# Exact-address verification. Only the official HTTPS PDOK host is accepted.
PDOK_LOCATIESERVER_BASE_URL=https://api.pdok.nl
PDOK_TIMEOUT_MS=5000

# Legacy importer/exporter paths. These are used only by npm run ingest:legacy,
# never by the public resident finder or the governed worker.
MANUAL_TIPS_PATH=data/manual-tips.example.jsonl
SOCIAL_REVIEW_PATH=data/review/social-mentions.json
EXPORT_PATH=data/exports/app-locations.json

# Allowed existing-map export. Enable it only after registering the matching source policy.
BUURTKASTJESKAART_EXPORT_PATH=

# Nextdoor has no scraper. Place an approved JSONL export inside APP_DATA_DIR.
NEXTDOOR_APPROVED_EXPORT_PATH=

# Optional, bounded OpenStreetMap pilot. Configure both values or neither.
# The bbox order is south,west,north,east and must be a non-empty area within the Netherlands.
OSM_OVERPASS_URL=
OSM_PILOT_BBOX=

# Facebook: official Graph API only, for explicitly approved Page IDs.
# Never put real access tokens in source control.
FACEBOOK_GRAPH_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=
# Example: [{"id":"1234567890","name":"Approved local page","city":"Utrecht","municipality":"Utrecht","province":"Utrecht"}]
FACEBOOK_PAGE_CONTEXTS_JSON=[]

# Optional read-only HAI JSON-feed bridge. Generate a random token of at least 32 characters.
HAI_FEED_TOKEN=
HAI_WORKSPACE_ID=
HAI_PROJECT_KEY=015-Weggeefkastje
