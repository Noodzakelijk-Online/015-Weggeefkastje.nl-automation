{
  "name": "weggeefkastje-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <26"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server-main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "ingest": "tsx src/worker.ts --once",
    "ingest:legacy": "tsx src/index.ts",
    "serve": "tsx src/server-main.ts",
    "start": "node dist/server-main.js",
    "worker": "tsx src/worker.ts",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "doctor": "tsx src/cli.ts doctor",
    "backup": "tsx src/cli.ts backup",
    "benchmark": "tsx src/benchmark.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "smoke": "vitest run --config vitest.config.ts tests/critical-path.test.ts",
    "windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "windows:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "windows:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-windows.ps1"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
